# ============================================================
# 企业知识库 · 私有化内网部署配置
# 复制为 .env 后按环境修改。默认全链路内网闭环，无任何公网依赖。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8088
# API Key 校验开关。开发态 false 便于本地联调；生产必须 true，
# 并在构建前端时用 VITE_API_KEY 注入同一个值。
API_KEY_ENABLED=false
API_KEY=change_me_in_prod
# 前端构建产物目录（FastAPI 单端口托管 SPA）
FRONTEND_DIST_DIR=web/dist

# ============================================================
# LLM 层：可插拔 provider 路由
#   local      = 内网 vLLM 自托管（air-gap 场景唯一选择）
#   deepseek   = DeepSeek 官方 API（数据出内网，需合规审批）
#   openai     = OpenAI 兼容服务
#   extractive = 抽取式回答 —— **没有生成模型时的诚实降级**：
#                从检索到的原文里挑出相关句子，原样引用并标注 [n]，
#                不改写、不编造。宁可给原文，也不给编出来的制度。
# 模型名对照（截至 2026-11-25 核实）：
#   deepseek-flash  = DeepSeek-V4.1-Flash-1017  ✅ 当前主力
#                      1M 上下文 / 384K 输出 / 原生图像理解
#                      off-peak $0.15 输入 / $0.60 输出 每百万 token
#   deepseek-v4-pro = DeepSeek-V4-Pro-0813      最难推理，已在逐步下线
#   ⚠️ deepseek-v4-flash      已退役别名，会被路由到 V4.1-Flash，不要直接用
#   ⚠️ deepseek-chat/reasoner 2026-07-24 已下线，不要用
# ============================================================

# ---- 主模型：生成答案 ----
LLM_PROVIDER=local
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=qwen3-32b
LLM_API_KEY=EMPTY

# ---- 升级模型：复杂推理/多跳问题（留空则不启用分级路由）----
# 填 deepseek 时：LLM_FALLBACK_PROVIDER=deepseek
#                  LLM_FALLBACK_MODEL=deepseek-flash
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
# 思考模式：DeepSeek 支持 thinking on/off；Qwen3 用 enable_thinking
# 抽取/改写类任务关掉，复杂推理打开
LLM_THINKING=false
# 抽取式回答（LLM_PROVIDER=extractive 时生效）最多摘几句、每句多长
EXTRACTIVE_MAX_SENTENCES=6
EXTRACTIVE_MAX_SENTENCE_CHARS=220

# ---- DeepSeek 专用（仅 LLM_PROVIDER=deepseek 时生效）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 峰时（01:00-04:00 & 06:00-10:00 UTC，工作日非节假日）价格翻倍，
# 可在峰时自动把简单请求路由到本地模型
DEEPSEEK_PEAK_HOURS_UTC=1-4,6-10

# ============================================================
# Embedding / Rerank（全部自托管，OpenAI 兼容）
#
# 后端三选一：
#   tei   = text-embeddings-inference 容器（生产，有 GPU）
#   local = sentence-transformers 在进程内加载（需完整 fp32 权重 2.1GB）
#   onnx  = ONNX Runtime int8 量化（离线单机，542MB，CPU 上快一个量级）
# ============================================================
EMBEDDING_BACKEND=tei
EMBEDDING_BASE_URL=http://tei-embed:80
# 默认 bge-m3（1024维/8192token，截至 2026-08 仍无 bge-m4 继任者）
# 备选 Qwen3-Embedding-8B（MTEB 多语言榜首 70.58）——务必用评估脚本实测后再换
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# bge 系列官方要求：query 加检索指令前缀，passage 不加。关闭仅用于非 bge 模型
EMBEDDING_USE_QUERY_INSTRUCTION=true
# onnx 后端用：模型与分词器在 LOCAL_MODEL_DIR 下的相对路径
# 先跑 `python -m scripts.fetch_models` 把模型拉到本地
ONNX_EMBEDDING_MODEL_FILE=bge-m3/model_int8.onnx
ONNX_EMBEDDING_TOKENIZER_FILE=bge-m3/tokenizer.json

RERANK_BACKEND=tei
RERANK_BASE_URL=http://tei-rerank:80
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ONNX_RERANK_MODEL_FILE=jina-reranker-v2-base-multilingual/model_int8.onnx
ONNX_RERANK_TOKENIZER_FILE=jina-reranker-v2-base-multilingual/tokenizer.json

# 本地模型根目录（离线部署时的预置目录）
LOCAL_MODEL_DIR=data/models
# ONNX 输入截断长度。bge-m3 支持 8192，CPU 上没必要拉满
ONNX_MAX_SEQ_LENGTH=512
# ONNX 推理线程数。每个线程都要预分配大缓冲区，16 核机器上不限制会 OOM。
# 想要 0 = 由 onnxruntime 自动决定，请先确认机器内存余量。
ONNX_NUM_THREADS=2
# BLAS 线程数（numpy/OpenBLAS）。必须在 numpy 导入前生效，
# app/__init__.py 里已经按 KB_MATH_THREADS 设了默认值
KB_MATH_THREADS=2

# ============================================================
# 文档解析（MinerU 3.x 服务 → 扫描件 OCR 兜底）
# ============================================================
# MinerU 是版面还原最强的，但需要 GPU 与模型服务。
# 没有它时置 false，解析走本地链路：
#   有文本层的 PDF → 直接读文本层（快且准）
#   扫描件 PDF     → PyMuPDF 渲染 + RapidOCR 识别 + 段落/标题重建
MINERU_ENABLED=true
MINERU_API_URL=http://mineru:8000
# effort: medium | high —— medium 精度仅降 0.13 分，速度提升 35%~220%
MINERU_BACKEND=pipeline
MINERU_EFFORT=medium
MINERU_LANG=ch
MINERU_TIMEOUT=600
# 扫描件 OCR 渲染倍率。原 PDF 是 108dpi 图片，2× 渲染后识别率明显更好
OCR_RENDER_SCALE=2.0
# 保留表格结构（拍平成纯文本会让对比类问题检索效果归零）
PARSER_KEEP_TABLE_STRUCTURE=true
# 页眉页脚检测阈值：同一行重复出现 N 次即判定为页眉/页脚
PARSER_HEADER_FOOTER_THRESHOLD=3

# ============================================================
# 存储后端（生产默认全套外部依赖；离线单机切 local）
#
#   VECTOR_BACKEND   = qdrant | local   （local = numpy 暴力余弦，单机）
#   KEYWORD_BACKEND  = elasticsearch | local  （local = Okapi BM25 + CJK 二元组）
#   DOC_BACKEND      = postgres | local （local = SQLite 文档登记表）
#   OBJECT_BACKEND   = minio | local    （local = 本地目录存原文）
#
# 切 local 时接口完全一致，管线代码一行不改 —— 生产路径始终是上面那套。
# ============================================================
VECTOR_BACKEND=qdrant
KEYWORD_BACKEND=elasticsearch
DOC_BACKEND=postgres
OBJECT_BACKEND=minio
# local 后端的数据目录
LOCAL_STORE_DIR=data/local_store

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_change_me
POSTGRES_DB=kb

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kb_chunks
QDRANT_VECTOR_SIZE=1024

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=kb_chunks

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-docs
MINIO_SECURE=false

# ============================================================
# 检索策略
# ============================================================
# 每路召回数量（召回段：宽召回，允许噪音）
RETRIEVE_TOP_K=50
# Rerank 后保留数量（精度段）
RERANK_TOP_K=8
# RRF 常数，越大越平滑，经验值 60
RRF_K=60
# 子块长度（token 估算），父块为章节级
CHILD_CHUNK_TOKENS=400
PARENT_CHUNK_TOKENS=2000
CHILD_CHUNK_OVERLAP=60
# 是否启用 Query 改写（多路改写 + HyDE）
ENABLE_QUERY_REWRITE=true

# ============================================================
# 权限
# ============================================================
# 用户无任何可见主体时的默认行为：false=拒绝（默认）
ACL_DEFAULT_ALLOW=false
# 权限前置过滤开关。生产必须 true，仅本地调试可临时 false
ACL_ENABLED=true

# ============================================================
# 模型仓库（内网 HF 镜像 / 离线模式）
# ============================================================
HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=
# 1 = 完全离线（模型已预置到缓存卷）
HF_OFFLINE=0
